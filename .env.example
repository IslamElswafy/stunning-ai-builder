# Server-side only. Never prefixed with NEXT_PUBLIC_, never sent to the browser.

# Required. OpenRouter API key — https://openrouter.ai/keys
# Sent as `Authorization: Bearer <key>` to https://openrouter.ai/api/v1
OPENROUTER_API_KEY=

# Optional. Overrides the model used by the generate route.
# Defaults to openrouter/free (see lib/ai.ts).
AI_MODEL=
